<?xml version="1.0" encoding="utf-8"?>
<!-- Зашифрованная БД и EncryptedSharedPreferences не переносимы между устройствами
     (ключ живёт в Android Keystore), поэтому исключаем их из бэкапа и переноса. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
